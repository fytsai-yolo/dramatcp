{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/roadmap.md", "docs/style.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run dev*": "allow",
      "npm run build*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
